# J.A.R.V.I.S. Backend Configuration
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

# Primary Default AI Provider (100% Local GPU & Free)
DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=qwen3:4b

# Optional Google Gemini Cloud Provider (Disabled by default, requires GEMINI_API_KEY)
# GEMINI_API_KEY=your_google_ai_studio_api_key_here
# GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# Optional Self-Hosted n8n Automation Webhooks (Disabled by default)
# N8N_ENABLED=false
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/jarvis-command
# N8N_AUTH_TOKEN=your_n8n_secret_token_here
